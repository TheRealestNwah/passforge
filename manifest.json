{
  "manifest_version": 3,
  "name": "Passmint",
  "version": "1.1.5",
  "description": "Generate strong, random passwords and passphrases with fine-grained complexity controls. Fully offline — nothing ever leaves your browser.",
  "author": "TheRealestNwah",
  "homepage_url": "https://github.com/TheRealestNwah/passmint",
  "browser_specific_settings": {
    "gecko": {
      "id": "passforge@therealestnwah.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "theme"
  ],
  "action": {
    "default_title": "Passmint — generate a password",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/toolbar.svg",
      "32": "icons/toolbar.svg"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
