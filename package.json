{
  "name": "passforge",
  "version": "1.1.3",
  "description": "Firefox extension that generates strong passwords and passphrases with fine-grained complexity controls.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/TheRealestNwah/passforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheRealestNwah/passforge.git"
  },
  "scripts": {
    "test": "node --test test/generator.test.js test/theme.test.js",
    "lint": "web-ext lint --source-dir=. --ignore-files=test test/** node_modules/** web-ext-artifacts/** .claude/**",
    "start": "web-ext run --source-dir=. --ignore-files=test test/** node_modules/** web-ext-artifacts/** .claude/**",
    "build": "web-ext build --source-dir=. --overwrite-dest --ignore-files=test test/** node_modules/** web-ext-artifacts/** .claude/** package*.json"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
